// Which detector arms the alarm. BOTH always run and both verdicts are always
// shown; this only selects which one drives the buzzer and LEDs, so the demo
// compares decision rules on identical live data rather than swapping
// firmware. 0 = conventional fixed threshold, 1 = SNIFF model.
volatile int alarmMode = 1;
