// Counts page and data requests served. Printed with the access-point status
// so a failed demo can be diagnosed in one line: clients=0 means the phone
// never associated at the radio level, clients=1 with hits climbing means the
// page is being served and the problem is elsewhere.
volatile uint32_t httpHits = 0;

